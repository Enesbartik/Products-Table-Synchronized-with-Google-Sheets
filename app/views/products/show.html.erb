<div class="page-header">
  <div>
    <h1 class="page-title"><%= @product.name %></h1>

    <p class="page-description">
      Product details and synchronization information.
    </p>
  </div>

  <div class="page-actions">
    <%= link_to "Edit",
                edit_product_path(@product),
                class: "button" %>

    <%= link_to "Back",
                products_path,
                class: "button button--secondary" %>

    <%= button_to "Delete",
                  @product,
                  method: :delete,
                  class: "button button--danger",
                  data: {
                    turbo_confirm: "Are you sure?"
                  } %>
  </div>
</div>

<div class="card">
  <div class="card__body">
    <div class="detail-grid">
      <div class="detail-item">
        <span class="detail-item__label">Price</span>

        <span class="detail-item__value">
          <%= number_to_currency(
                @product.price,
                unit: "₺",
                format: "%n %u"
              ) %>
        </span>
      </div>

      <div class="detail-item">
        <span class="detail-item__label">Stock</span>

        <span class="detail-item__value">
          <%= @product.stock %>
        </span>
      </div>

      <div class="detail-item">
        <span class="detail-item__label">Category</span>

        <span class="detail-item__value">
          <%= @product.category.presence || "-" %>
        </span>
      </div>

      <div class="detail-item">
        <span class="detail-item__label">Source</span>

        <span class="detail-item__value">
          <% if @product.sheet_managed? %>
            <span class="badge badge--success">
              Google Sheets
            </span>
          <% else %>
            <span class="badge badge--neutral">
              Local
            </span>
          <% end %>
        </span>
      </div>

      <div class="detail-item">
        <span class="detail-item__label">Sync Key</span>

        <span class="detail-item__value">
          <%= @product.sync_key %>
        </span>
      </div>

      <div class="detail-item">
        <span class="detail-item__label">Last Synced</span>

        <span class="detail-item__value">
          <%= @product.last_synced_at&.strftime("%d.%m.%Y %H:%M") || "Never" %>
        </span>
      </div>
    </div>
  </div>
</div>