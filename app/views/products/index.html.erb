<div class="page-header">
  <div>
    <h1 class="page-title">Products</h1>

    <p class="page-description">
      Manage products and synchronize them with Google Sheets.
    </p>
  </div>

  <div class="page-actions">
    <%= button_to "Sync from Google Sheets",
                  sheet_sync_path,
                  method: :post,
                  class: "button button--secondary" %>

    <%= link_to "New Product",
                new_product_path,
                class: "button" %>
  </div>
</div>


<div class="filter-panel">
  <h2>Filter Products</h2>

  <%= form_with url: products_path,
                method: :get,
                local: true,
                class: "filter-form" do |form| %>

    <div class="filter-field">
      <%= form.label :name, "Product name" %>

      <%= form.text_field :name,
                          value: params[:name],
                          placeholder: "Search by name" %>
    </div>

    <div class="filter-field">
      <%= form.label :category, "Category" %>

      <%= form.select :category,
                      options_for_select(
                        @categories,
                        params[:category]
                      ),
                      {
                        include_blank: "All categories"
                      } %>
    </div>

    <div class="filter-field">
      <%= form.label :min_price, "Minimum price" %>

      <%= form.number_field :min_price,
                            value: params[:min_price],
                            min: 0,
                            step: 0.01 %>
    </div>

    <div class="filter-field">
      <%= form.label :max_price, "Maximum price" %>

      <%= form.number_field :max_price,
                            value: params[:max_price],
                            min: 0,
                            step: 0.01 %>
    </div>

    <div class="filter-field">
      <%= form.label :sheet_managed, "Source" %>

      <%= form.select :sheet_managed,
                      options_for_select(
                        [
                          ["All products", ""],
                          ["Google Sheets", "true"],
                          ["Local", "false"]
                        ],
                        params[:sheet_managed]
                      ) %>
    </div>

    <div class="filter-actions">
      <%= form.submit "Apply Filters",
                      class: "button button-primary" %>

      <%= link_to "Clear Filters",
                  products_path,
                  class: "button button-secondary" %>
    </div>
  <% end %>
</div>

<p class="filter-result-count">
  <strong><%= @products.count %></strong>
  product(s) found
</p>



<div class="card">
  <% if @products.any? %>
    <div class="table-wrapper">
      <table class="products-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Category</th>
            <th>Source</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @products.each do |product| %>
            <tr>
              <td class="product-name">
                <%= product.name %>
              </td>

              <td>
                <%= number_to_currency(
                      product.price,
                      unit: "₺",
                      format: "%n %u"
                    ) %>
              </td>

              <td>
                <%= product.stock %>
              </td>

              <td class="product-category">
                <%= product.category.presence || "-" %>
              </td>

              <td>
                <% if product.sheet_managed? %>
                  <span class="badge badge--success">
                    Google Sheets
                  </span>
                <% else %>
                  <span class="badge badge--neutral">
                    Local
                  </span>
                <% end %>
              </td>

              <td>
                <div class="action-group">
                  <%= link_to "Show",
                              product,
                              class: "button button--secondary button--small" %>

                  <%= link_to "Edit",
                              edit_product_path(product),
                              class: "button button--secondary button--small" %>

                  <%= button_to "Delete",
                                product,
                                method: :delete,
                                class: "button button--danger button--small",
                                data: {
                                  turbo_confirm: "Are you sure?"
                                } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h2>No products yet</h2>

      <p>Create your first product or synchronize Google Sheets.</p>
    </div>
  <% end %>
</div>