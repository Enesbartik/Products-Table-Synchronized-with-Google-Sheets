<div class="page-header">
  <div>
    <h1 class="page-title">Products</h1>

    <p class="page-description">
      Manage products and synchronize them with Google Sheets.
    </p>
  </div>

  <div class="page-actions">
    <%= button_to "Sync from Google Sheets",
                  sheet_sync_path,
                  method: :post,
                  class: "button button--secondary" %>

    <%= link_to "New Product",
                new_product_path,
                class: "button" %>
  </div>
</div>

<div class="card">
  <% if @products.any? %>
    <div class="table-wrapper">
      <table class="products-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Category</th>
            <th>Source</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @products.each do |product| %>
            <tr>
              <td class="product-name">
                <%= product.name %>
              </td>

              <td>
                <%= number_to_currency(
                      product.price,
                      unit: "₺",
                      format: "%n %u"
                    ) %>
              </td>

              <td>
                <%= product.stock %>
              </td>

              <td class="product-category">
                <%= product.category.presence || "-" %>
              </td>

              <td>
                <% if product.sheet_managed? %>
                  <span class="badge badge--success">
                    Google Sheets
                  </span>
                <% else %>
                  <span class="badge badge--neutral">
                    Local
                  </span>
                <% end %>
              </td>

              <td>
                <div class="action-group">
                  <%= link_to "Show",
                              product,
                              class: "button button--secondary button--small" %>

                  <%= link_to "Edit",
                              edit_product_path(product),
                              class: "button button--secondary button--small" %>

                  <%= button_to "Delete",
                                product,
                                method: :delete,
                                class: "button button--danger button--small",
                                data: {
                                  turbo_confirm: "Are you sure?"
                                } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h2>No products yet</h2>

      <p>Create your first product or synchronize Google Sheets.</p>
    </div>
  <% end %>
</div>